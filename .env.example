# Public application URLs
APP_ENV=development
WEB_PORT=3001
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3001"]

# One-time bootstrap on an empty database. Login ID is the phone number;
# the password is a 6-12 digit PIN. Set these before running the bootstrap CLI.
BOOTSTRAP_NAME="Demo cooperative"
BOOTSTRAP_PHONE=
BOOTSTRAP_PIN=
BOOTSTRAP_EMAIL=

# Staff phone/PIN login is available in all environments; OIDC providers are optional.
# Set false to require a configured OIDC provider for staff sign-in instead.
STAFF_PIN_LOGIN_ENABLED=true

# Application secrets (supply through .env or process environment)
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_SESSION_SECRET=replace-with-an-independent-32-character-secret

# Centralized Postgres + pgvector
DATABASE_URL=postgresql+asyncpg://agriverse:change-me@infra-host:5432/agriverse
# Optional separate DDL-capable connection, used only by Alembic/admin commands.
MIGRATION_DATABASE_URL=

# Optional organization CA PEM bundle; OS trusted roots are included automatically.
TLS_CA_BUNDLE=

# Centralized Redis
REDIS_URL=redis://infra-host:6379/0
USER_REQUESTS_PER_MINUTE=60
ORGANIZATION_REQUESTS_PER_MINUTE=600
ORGANIZATION_AI_CALLS_PER_DAY=500

# Centralized MinIO AIStor
S3_ENDPOINT_URL=http://infra-host:9000
S3_PUBLIC_ENDPOINT_URL=https://objects.example.com
# Local wisdom bucket route: https://wisdom-dev.local (the /minio/ path is the console).
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=agriverse
S3_REGION=us-east-1
# AES256 is the default and required in staging/production.
# MinIO Free local testing only: none stores image objects without server-side encryption.
S3_SERVER_SIDE_ENCRYPTION=AES256

# Direct OpenAI API (primary)
OPENAI_API_KEY=
OPENAI_GATE_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_AGENT_MODEL=gpt-5.6-sol

# Direct provider retrieval
# Gemini is optional fallback; ingestion prepares separate vectors for both configured keys.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RERANK_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_GATE_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_RERANK_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_SECONDS=45
VECTOR_DIMENSION=1024

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OpenTelemetry and optional Langfuse
# Leave empty to disable telemetry export; set your collector's HTTP endpoint to enable it.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agriverse-api
LANGFUSE_HOST=https://wisdom-dev.local/langfuse/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# All three Langfuse values enable metadata-only LLM traces independently of OTel.

# Staff OIDC (configure the providers you use)
# Example issuer: http://localhost:8080/realms/agriverse
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:8000/api/v1
WEB_OAUTH_CALLBACK_URL=http://localhost:3001/api/oauth/callback
