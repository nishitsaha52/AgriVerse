# Public application URLs
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Application secrets (store production values in Infisical)
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_SESSION_SECRET=replace-with-an-independent-32-character-secret
FIELD_DATA_ENCRYPTION_KEY=

# Centralized Postgres 17 + pgvector
DATABASE_URL=postgresql+asyncpg://agriverse:change-me@infra-host:5432/agriverse

# Centralized Redis
REDIS_URL=redis://infra-host:6379/0
USER_REQUESTS_PER_MINUTE=60
ORGANIZATION_REQUESTS_PER_MINUTE=600
ORGANIZATION_AI_CALLS_PER_DAY=500

# Centralized MinIO AIStor
S3_ENDPOINT_URL=http://infra-host:9000
S3_PUBLIC_ENDPOINT_URL=https://objects.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=agriverse
S3_REGION=us-east-1

# LiteLLM OpenAI-compatible gateway
OPENAI_BASE_URL=http://infra-host:4000/v1
OPENAI_API_KEY=replace-with-litellm-virtual-key
OPENAI_GATE_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_AGENT_MODEL=gpt-5.6-sol

# Voyage retrieval
VOYAGE_API_KEY=replace-me
VOYAGE_IMAGE_MODEL=voyage-multimodal-3.5
VOYAGE_TEXT_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-2.5
VECTOR_DIMENSION=1024

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
IMD_API_BASE_URL=
IMD_API_KEY=

# OpenTelemetry and optional Langfuse
OTEL_EXPORTER_OTLP_ENDPOINT=http://infra-host:4318
OTEL_SERVICE_NAME=agriverse-api
LANGFUSE_HOST=http://infra-host:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Staff OIDC (configure either or both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=https://agriverse.example.com/api/v1
WEB_OAUTH_CALLBACK_URL=https://agriverse.example.com/api/oauth/callback
